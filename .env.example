# Copy to .env.local and fill in. Every value is read on the server at runtime.

# Public URL of this portal, without a trailing slash. Keycloak must accept
# <APP_URL>/auth/callback as a redirect URI and <APP_URL>/* as a post-logout redirect URI.
APP_URL=http://localhost:3000

# Skill-Wanderer SSO (Keycloak). Production uses the client-portal realm.
KEYCLOAK_ISSUER=https://sso.skill-wanderer.com/realms/client-portal
KEYCLOAK_CLIENT_ID=client-portal-fe
# Leave empty while client-portal-fe is a public client (PKCE only).
# Set it if the client is switched to "Client authentication: On".
KEYCLOAK_CLIENT_SECRET=
# Space-separated. Add "organization" to read Keycloak organization membership.
KEYCLOAK_SCOPE="openid profile email"

# At least 32 random characters; encrypts the session cookie. Changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
